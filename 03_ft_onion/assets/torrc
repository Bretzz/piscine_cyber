# so entrypoint,sh can fork it safely
RunAsDaemon 1

# Allow SOCKS connections from outside the container.
# Needed to use this tor instance to navigate through tor
SocksPort 0.0.0.0:9050

# Setup the Onion Service
# Niginx trough Unix Socket
HiddenServiceDir /var/lib/tor/ft_onion/
HiddenServicePort 80 unix:/var/lib/tor/ft_onion/onion.sock
# SSH trough standard IP routing
HiddenServicePort 4242 127.0.0.1:22